          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  ge.event_time AS \"Time\",\r\n  ge.event_type AS \"Event\",\r\n  CASE\r\n    WHEN ge.player_id IS NULL THEN ''\r\n    WHEN ge.player_id = 'HOUSE' THEN 'DEALER'\r\n    ELSE COALESCE(p.player_name, ge.player_id)\r\n  END AS \"Player\",\r\n  ge.summary AS \"Details\"\r\nFROM game_events ge\r\nLEFT JOIN players p ON ge.player_id = p.player_id\r\nWHERE ge.table_id = '${table_id}'\r\n  AND $__timeFilter(ge.event_time)\r\nORDER BY ge.event_time DESC\r\nLIMIT 200",
          "refId": "A",
          "sql": {
            "columns": [
