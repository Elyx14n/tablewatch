        "x": 16,
        "y": 0
      },
      "id": 6,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": false,
        "showThresholdMarkers": true,
        "sizing": "auto",
        "text": {}
      },
      "pluginVersion": "12.4.1",
      "targets": [
        {
          "dataset": "tablewatch",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "  SELECT                                                                                                                                                                              \r\n      ROUND(100.0 * COUNT(*) FILTER (WHERE pa.anomaly_type = 'CARD_COUNTING'         AND p.role <> 'casual') / NULLIF(COUNT(*) FILTER (WHERE pa.anomaly_type = 'CARD_COUNTING'), 0),\r\n  2)         AS \"Card Counting\",                                                                                                                                                      \r\n      ROUND(100.0 * COUNT(*) FILTER (WHERE pa.anomaly_type = 'HIGH_BET_SPREAD'        AND p.role <> 'casual') / NULLIF(COUNT(*) FILTER (WHERE pa.anomaly_type = 'HIGH_BET_SPREAD'),   \r\n  0), 2)        AS \"High Bet Spread\",                                                                                                                                                 \r\n      ROUND(100.0 * COUNT(*) FILTER (WHERE pa.anomaly_type = 'WONGING_ENTRY_ANOMALY'  AND p.role <> 'casual') / NULLIF(COUNT(*) FILTER (WHERE pa.anomaly_type =                       \r\n  'WONGING_ENTRY_ANOMALY'), 0), 2)  AS \"Wonging Entry\",                                                                                                        \r\n      ROUND(100.0 * COUNT(*) FILTER (WHERE pa.anomaly_type = 'BET_VELOCITY_SPIKE'     AND p.role <> 'casual') / NULLIF(COUNT(*) FILTER (WHERE pa.anomaly_type = 'BET_VELOCITY_SPIKE'),\r\n   0), 2)     AS \"Bet Velocity Spike\",                                                                                                                                                \r\n      ROUND(100.0 * COUNT(*) FILTER (WHERE pa.anomaly_type = 'IMPOSSIBLE_WIN_RATE'    AND p.role <> 'casual') / NULLIF(COUNT(*) FILTER (WHERE pa.anomaly_type =                       \r\n  'IMPOSSIBLE_WIN_RATE'), 0), 2)    AS \"Impossible Win Rate\"                                                                                                   \r\n  FROM player_anomalies pa                                                                                                                                                            \r\n  LEFT JOIN players p ON pa.player_id = p.player_id         \r\n  WHERE $__timeFilter(pa.anomaly_detected_at)  ",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Detection Accuracy",
      "type": "gauge"
    },
