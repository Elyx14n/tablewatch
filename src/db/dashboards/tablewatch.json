      "targets": [
        {
          "dataset": "tablewatch",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n  ROUND(100.0 * COUNT(*) FILTER (WHERE pa.anomaly_type = 'CARD_COUNTING'        AND p.role IN ('advantage', 'back_counter', 'spotter', 'big_player')) / NULLIF(COUNT(*) FILTER (WHERE pa.anomaly_type = 'CARD_COUNTING'), 0), 2)        AS \"Card Counting\",\r\n  ROUND(100.0 * COUNT(*) FILTER (WHERE pa.anomaly_type = 'HIGH_BET_SPREAD'       AND p.role IN ('advantage', 'back_counter')) / NULLIF(COUNT(*) FILTER (WHERE pa.anomaly_type = 'HIGH_BET_SPREAD'), 0), 2)       AS \"High Bet Spread\",\r\n  ROUND(100.0 * COUNT(*) FILTER (WHERE pa.anomaly_type = 'WONGING_ENTRY_ANOMALY' AND p.role IN ('advantage','big_player', 'back_counter')) / NULLIF(COUNT(*) FILTER (WHERE pa.anomaly_type = 'WONGING_ENTRY_ANOMALY'), 0), 2) AS \"Wonging Entry\"\r\nFROM player_anomalies pa\r\nLEFT JOIN players p ON pa.player_id = p.player_id\r\nWHERE $__timeFilter(pa.anomaly_detected_at)",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Detection Accuracy",
      "type": "gauge"
