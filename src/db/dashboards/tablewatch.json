          "rawQuery": true,
          "rawSql": " SELECT\r\n    COUNT(*) FILTER (WHERE anomaly_type = 'CARD_COUNTING')            AS \"Card Counting\",                                                                                             \r\n    COUNT(*) FILTER (WHERE anomaly_type = 'HIGH_BET_SPREAD')          AS \"High Bet Spread\",                                                                                           \r\n    COUNT(*) FILTER (WHERE anomaly_type = 'WONGING_ENTRY_ANOMALY')    AS \"Wonging Entry\",                                                                                             \r\n    COUNT(*) FILTER (WHERE anomaly_type = 'BET_VELOCITY_SPIKE')       AS \"Bet Velocity Spike\",                                                                                        \r\n    COUNT(*) FILTER (WHERE anomaly_type = 'IMPOSSIBLE_WIN_RATE')      AS \"Impossible Win Rate\"                                                                                        \r\n  FROM player_anomalies                                                                                                                                                               \r\n  WHERE $__timeFilter(anomaly_detected_at)  ",
