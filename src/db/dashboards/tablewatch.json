        {
          "dataset": "tablewatch",
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n    p.player_name,\r\n    p.role,\r\n    COUNT(a.anomaly_type) AS anomaly_count,\r\n    ROUND(MAX(a.anomaly_confidence) * 100, 2) AS highest_confidence,\r\n    STRING_AGG(DISTINCT a.anomaly_type, ', ') AS anomaly_types\r\nFROM player_anomalies a\r\nJOIN players p ON a.player_id = p.player_id\r\nWHERE $__timeFilter(a.anomaly_detected_at)\r\nGROUP BY p.player_id, p.role\r\nORDER BY highest_confidence DESC;",
          "refId": "A",
