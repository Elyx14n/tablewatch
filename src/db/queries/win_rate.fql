INSERT INTO
  player_anomalies WITH PlayerStats AS (
    SELECT
      player_id,
      window_start,
      window_end,
      CAST(
        SUM(
          CASE
          WHEN `result` IN ('win', 'blackjack') THEN 1
          ELSE 0 END
        ) AS DOUBLE
      ) / NULLIF(COUNT(*), 0) AS win_rate,
      COUNT(*) AS hand_count
    FROM
      TABLE(
        HOP(
          TABLE outcome_events,
          DESCRIPTOR(event_time),
          INTERVAL '5' MINUTES,
          INTERVAL '4' HOURS
        )
      )
    GROUP
      BY player_id,
      window_start,
      window_end
    HAVING
      COUNT(*) >= 50
  ),
  PopulationPercentiles AS (
    SELECT
      window_end,
      PERCENTILE(win_rate, 0.25) AS q1,
      PERCENTILE(win_rate, 0.75) AS q3
    FROM
      PlayerStats
    GROUP BY window_end
  ),
  Scoring AS (
    SELECT
      ps.player_id,
      ps.window_end,
      ps.win_rate,
      pp.q1,
      pp.q3,
      (pp.q3 - pp.q1) AS iqr,
      (pp.q3 + 1.5 * (pp.q3 - pp.q1)) AS upper_fence
    FROM
      PlayerStats ps
    JOIN
      PopulationPercentiles pp
    ON ps.window_end = pp.window_end
    WHERE
      ps.win_rate > 0.55
  )
SELECT
  player_id,
  'IMPOSSIBLE_WIN_RATE_IQR' AS anomaly_type,
  LEAST((win_rate - upper_fence) / NULLIF(iqr, 0), 1.0) AS anomaly_confidence,
  window_end AS anomaly_detected_at,
  win_rate,
  q1,
  q3,
  iqr
FROM
  Scoring
WHERE
  win_rate > upper_fence;