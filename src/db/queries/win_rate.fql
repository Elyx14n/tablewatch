INSERT INTO
  player_anomalies WITH PlayerStats AS (
    SELECT
      player_id,
      window_start,
      window_end,
      CAST(
        SUM(
          CASE
          WHEN `result` IN ('win', 'blackjack') THEN 1
          ELSE 0 END
        ) AS DOUBLE
      ) / NULLIF(COUNT(*), 0) AS win_rate,
      COUNT(*) AS hand_count
    FROM
      TABLE(
        HOP(
          TABLE outcome_events,
          DESCRIPTOR(event_time),
          INTERVAL '5' MINUTES,
          INTERVAL '4' HOURS
        )
      )
    GROUP
      BY player_id,
      window_start,
      window_end
    HAVING
      COUNT(*) >= 50
  ),
  PopulationStats AS (
    SELECT
      window_end,
      SUM(win_rate * hand_count) / SUM(hand_count) AS avg_win_rate
    FROM
      PlayerStats
    GROUP
      BY window_end
  ),
  Scoring AS (
    SELECT
      ps.player_id,
      ps.window_end,
      ps.win_rate,
      (ps.win_rate - pp.avg_win_rate) / NULLIF(
        SQRT(
          pp.avg_win_rate * (1 - pp.avg_win_rate) / ps.hand_count
        ),
        0
      ) AS z_score
    FROM
      PlayerStats ps
      JOIN PopulationStats pp ON ps.window_end = pp.window_end
    WHERE
      ps.win_rate > 0.55
  )
SELECT
  player_id,
  'IMPOSSIBLE_WIN_RATE' AS anomaly_type,
  LEAST((z_score - 3.0) / 2.0, 1.0) AS anomaly_confidence,
  window_end AS anomaly_detected_at,
  win_rate,
  z_score
FROM
  Scoring
WHERE
  z_score > 3.0;