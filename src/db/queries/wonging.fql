INSERT INTO
  player_anomalies WITH WindowedEvents AS (
    SELECT
      player_id,
      true_count,
      event_time,
      window_start
    FROM
      TABLE(
        SESSION(
          TABLE bet_events,
          DESCRIPTOR(event_time),
          INTERVAL '20' MINUTES
        )
      )
    WHERE
      is_shuffle = FALSE
  ),
  PlayerSessions AS (
    SELECT
      player_id,
      true_count AS entry_count,
      event_time,
      ROW_NUMBER() OVER (
        PARTITION BY player_id,
        window_start
        ORDER
          BY event_time ASC
      ) AS bet_sequence
    FROM
      WindowedEvents
  ),
  EntriesOnly AS (
    SELECT
      player_id,
      entry_count,
      event_time
    FROM
      PlayerSessions
    WHERE
      bet_sequence = 1
  )
SELECT
  player_id,
  'WONGING_ENTRY_ANOMALY' AS anomaly_type,
  LEAST(entry_count / 5.0, 1.0) AS anomaly_confidence,
  event_time AS anomaly_detected_at,
  entry_count AS wonging_score
FROM
  EntriesOnly
WHERE
  entry_count > 3.0;