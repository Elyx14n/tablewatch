INSERT INTO
  player_anomalies WITH DirectPairs AS (
    -- Degree 1: Direct Connections
    SELECT
      player_id_1 AS p1,
      player_id_2 AS p2,
      correlation
    FROM
      player_correlations
    UNION
    ALL
    SELECT
      player_id_2 AS p1,
      player_id_1 AS p2,
      correlation
    FROM
      player_correlations
  ),
  SecondDegree AS (
    -- Degree 2: Friends of Friends
    SELECT
      d1.p1,
      d2.p2 AS connected_player,
      d2.correlation
    FROM
      DirectPairs d1
      JOIN DirectPairs d2 ON d1.p2 = d2.p1
    WHERE
      d2.p2 <> d1.p1 -- Don't go back to yourself
  ),
  CombinedNetwork AS (
    SELECT
      p1 AS player_id,
      p2 AS connected_player,
      correlation
    FROM
      DirectPairs
    UNION
    ALL
    SELECT
      p1,
      connected_player,
      correlation
    FROM
      SecondDegree
  ),
  NetworkSummary AS (
    SELECT
      player_id,
      COUNT(DISTINCT connected_player) AS network_size,
      AVG(correlation) AS avg_corr
    FROM
      CombinedNetwork
    GROUP
      BY player_id
    HAVING
      COUNT(DISTINCT connected_player) >= 2
  )
SELECT
  player_id,
  'TEAM_COLLUSION_NETWORK' AS anomaly_type,
  CASE
  WHEN (0.6 * (network_size / 5.0)) + (0.4 * avg_corr) > 1.0 THEN 1.0
  ELSE (0.6 * (network_size / 5.0)) + (0.4 * avg_corr) END AS anomaly_confidence,
  LOCALTIMESTAMP AS anomaly_detected_at,
  avg_corr AS team_correlation
FROM
  NetworkSummary;