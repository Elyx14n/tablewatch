INSERT INTO
  player_anomalies WITH CountCorrelation AS (
    SELECT
      player_id,
      window_end,
      CORR(
        CAST(bet_amount AS DOUBLE),
        CAST(true_count AS DOUBLE)
      ) AS count_corr,
      COUNT(*) AS hand_count
    FROM
      TABLE(
        HOP(
          TABLE bet_events,
          DESCRIPTOR(event_time),
          INTERVAL '5' MINUTES,
          INTERVAL '1' HOUR
        )
      )
    WHERE
      is_shuffle = FALSE
    GROUP
      BY player_id,
      window_start,
      window_end
    HAVING
      COUNT(*) >= 20
  )
SELECT
  player_id,
  'CARD_COUNTING' AS anomaly_type,
  LEAST((count_corr - 0.5) / 0.3, 1.0) AS anomaly_confidence,
  window_end AS anomaly_detected_at,
  count_corr
FROM
  CountCorrelation
WHERE
  count_corr > 0.5;