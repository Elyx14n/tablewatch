INSERT INTO
  player_correlations WITH FilteredBets AS (
    SELECT
      player_id,
      team_id,
      table_id,
      event_time,
      bet_amount
    FROM
      bet_events
    WHERE
      is_shuffle = FALSE
  ),
  PlayerPairs AS (
    SELECT
      A.player_id AS player_id_1,
      b.player_id AS player_id_2,
      A.table_id,
      A.event_time
    FROM
      FilteredBets A
      INNER JOIN FilteredBets b ON A.table_id = b.table_id
      AND A.event_time = b.event_time
      AND A.player_id < b.player_id
  ),
  WindowedPairs AS (
    SELECT
      pp.player_id_1,
      pp.player_id_2,
      pp.table_id,
      pp.window_start,
      pp.window_end,
      CORR(A.bet_amount, b.bet_amount) AS correlation,
      COUNT(*) AS shared_hands,
      MAX(
        A.team_id = b.team_id
        AND A.team_id IS NOT NULL
      ) AS is_actual_team
    FROM
      TABLE(
        HOP(
          TABLE PlayerPairs,
          DESCRIPTOR(event_time),
          INTERVAL '5' MINUTES,
          INTERVAL '1' HOUR
        )
      ) pp
      INNER JOIN FilteredBets A ON pp.player_id_1 = A.player_id
      AND pp.table_id = A.table_id
      AND A.event_time >= pp.window_start
      AND A.event_time < pp.window_end
      INNER JOIN FilteredBets b ON pp.player_id_2 = b.player_id
      AND pp.table_id = b.table_id
      AND b.event_time >= pp.window_start
      AND b.event_time < pp.window_end
      AND A.event_time = b.event_time
    GROUP
      BY pp.player_id_1,
      pp.player_id_2,
      pp.table_id,
      pp.window_start,
      pp.window_end
    HAVING
      COUNT(*) >= 20
  )
SELECT
  player_id_1,
  player_id_2,
  correlation,
  window_end,
  is_actual_team
FROM
  WindowedPairs
WHERE
  correlation > 0.6;