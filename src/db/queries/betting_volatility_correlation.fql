INSERT INTO
  player_correlations
WITH FilteredBets AS (
  SELECT
    player_id,
    team_id,
    table_id,
    round_id,
    event_time,
    bet_amount
  FROM
    bet_events
  WHERE
    is_shuffle = FALSE
),
PlayerPairBets AS (
  SELECT
    A.player_id AS player_id_1,
    b.player_id AS player_id_2,
    A.team_id AS team_id_1,
    b.team_id AS team_id_2,
    A.table_id,
    A.event_time AS pair_time,
    A.bet_amount AS bet_amount_1,
    b.bet_amount AS bet_amount_2
  FROM
    FilteredBets A
    INNER JOIN FilteredBets b ON A.table_id = b.table_id
    AND A.round_id = b.round_id
    AND A.player_id < b.player_id
    AND b.event_time BETWEEN A.event_time - INTERVAL '30' SECONDS
    AND A.event_time + INTERVAL '30' SECONDS
),
WindowedStats AS (
  SELECT
    player_id_1,
    player_id_2,
    window_end,
    COUNT(*) AS shared_hands,
    AVG(bet_amount_1 * bet_amount_2) - AVG(bet_amount_1) * AVG(bet_amount_2) AS cov,
    (AVG(bet_amount_1 * bet_amount_1) - AVG(bet_amount_1) * AVG(bet_amount_1))
      * (AVG(bet_amount_2 * bet_amount_2) - AVG(bet_amount_2) * AVG(bet_amount_2)) AS var_product,
    MAX(
      CASE
        WHEN team_id_1 = team_id_2
        AND team_id_1 IS NOT NULL THEN 1
        ELSE 0
      END
    ) > 0 AS is_actual_team
  FROM
    TABLE(
      HOP(
        TABLE PlayerPairBets,
        DESCRIPTOR(pair_time),
        INTERVAL '5' MINUTES,
        INTERVAL '30' MINUTES
      )
    )
  GROUP BY
    player_id_1,
    player_id_2,
    window_start,
    window_end
  HAVING
    COUNT(*) >= 10
)
SELECT
  player_id_1,
  player_id_2,
  cov / NULLIF(SQRT(var_product), 0) AS correlation,
  window_end,
  is_actual_team
FROM
  WindowedStats
WHERE
  var_product > 0
  AND cov / NULLIF(SQRT(var_product), 0) > 0.6
