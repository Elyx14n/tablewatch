INSERT INTO player_anomalies WITH ShortWindow AS (
		SELECT player_id,
			window_end,
			window_time,
			AVG(bet_amount) AS short_avg
		FROM TABLE(
				HOP(
					TABLE bet_events,
					DESCRIPTOR(event_time),
					INTERVAL '5' MINUTES,
					INTERVAL '30' MINUTES
				)
			)
		WHERE is_shuffle = FALSE
		GROUP BY player_id,
			window_start,
			window_end,
			window_time
		HAVING COUNT(*) >= 5
	),
	LongWindow AS (
		SELECT player_id,
			window_end,
			window_time,
			AVG(bet_amount) AS long_avg
		FROM TABLE(
				HOP(
					TABLE bet_events,
					DESCRIPTOR(event_time),
					INTERVAL '5' MINUTES,
					INTERVAL '2' HOURS
				)
			)
		WHERE is_shuffle = FALSE
		GROUP BY player_id,
			window_start,
			window_end,
			window_time
		HAVING COUNT(*) >= 20
	)
SELECT s.player_id,
	'BET_VELOCITY_SPIKE' AS anomaly_type,
	LEAST(s.short_avg / NULLIF(l.long_avg, 0) - 1.0, 1.0) AS anomaly_confidence,
	s.window_end AS anomaly_detected_at,
	s.short_avg / NULLIF(l.long_avg, 0) - 1.0 AS bet_change_rate,
	s.short_avg / NULLIF(l.long_avg, 0) - 1.0 AS z_score
FROM ShortWindow s
JOIN LongWindow l
	ON s.player_id = l.player_id
	AND l.window_time BETWEEN s.window_time - INTERVAL '1' SECOND AND s.window_time + INTERVAL '1' SECOND
WHERE s.short_avg / NULLIF(l.long_avg, 0) - 1.0 > 2.0;